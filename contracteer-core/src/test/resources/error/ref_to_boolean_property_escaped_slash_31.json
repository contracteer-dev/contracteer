{
  "openapi": "3.1.0",
  "info": {
    "title": "Test API",
    "version": "1.0",
    "description": "Escapes a slash, which JSON allows and YAML does not: http:\/\/example.com"
  },
  "paths": {
    "/x": {
      "get": {
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#\/components\/schemas\/Foo\/properties\/forbidden"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Foo": {
        "type": "object",
        "properties": {
          "forbidden": false
        }
      }
    }
  }
}
